# ==============================================================================
# ProcureIQ Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local or cloud PostgreSQL database.
# In local development mode without PostgreSQL, the pipeline automatically falls
# back to embedded DuckDB/SQLite for 100% frictionless execution.
# ==============================================================================

# Database Engine Selection: 'postgresql' or 'duckdb'
DB_ENGINE=postgresql

# PostgreSQL Warehouse Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=procureiq_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SCHEMA=public

# Warehouse Medallion Architecture Schemas (for PostgreSQL)
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# Data Generator Configuration
RANDOM_SEED=42
NUM_VENDORS=500
NUM_PURCHASE_ORDERS=5000
NUM_PO_LINE_ITEMS=8000
NUM_DELIVERIES=5000
NUM_INVOICES=5000
NUM_COMPLIANCE_RECORDS=500

# Pipeline Settings
LOG_LEVEL=INFO
ENABLE_ANOMALY_DETECTION=True
EXPORT_POWERBI_CSVS=True
